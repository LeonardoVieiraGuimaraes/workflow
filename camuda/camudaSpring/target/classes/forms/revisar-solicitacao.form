{
  "schemaVersion": 9,
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.0.0"
  },
  "components": [
    {
      "text": "## 📋 Revisar Solicitação",
      "type": "text",
      "id": "titulo"
    },
    {
      "label": "Solicitante",
      "type": "textfield",
      "id": "solicitante",
      "key": "solicitante",
      "disabled": true,
      "validate": {
        "required": true
      }
    },
    {
      "label": "Descrição",
      "type": "textarea",
      "id": "descricao",
      "key": "descricao",
      "disabled": true,
      "validate": {
        "required": true
      }
    },
    {
      "label": "Valor (R$)",
      "type": "number",
      "id": "valor",
      "key": "valor",
      "disabled": true,
      "decimalDigits": 2,
      "validate": {
        "required": true
      }
    },
    {
      "text": "---",
      "type": "text",
      "id": "separador1"
    },
    {
      "text": "### ✅ Decisão de Revisão",
      "type": "text",
      "id": "tituloDecisao"
    },
    {
      "label": "Status da Aprovação",
      "type": "radio",
      "id": "aprovado",
      "key": "aprovado",
      "values": [
        {
          "label": "✅ Aprovar",
          "value": "true"
        },
        {
          "label": "❌ Rejeitar",
          "value": "false"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Comentários da Revisão",
      "type": "textarea",
      "id": "comentarioRevisao",
      "key": "comentarioRevisao",
      "description": "Adicione observações sobre sua decisão"
    }
  ],
  "type": "default",
  "id": "revisar-solicitacao"
}
