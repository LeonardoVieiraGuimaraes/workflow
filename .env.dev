# Ambiente: DEVELOPMENT (Local)

# Autenticação n8n (desabilitada para facilitar testes)
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER=dev@localhost.com
N8N_PASSWORD=dev123

# Domínio/Host
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone e Idioma
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_DEFAULT_LOCALE=pt-BR

# Configurações de desenvolvimento
N8N_LOG_LEVEL=debug
N8N_DIAGNOSTICS_ENABLED=false
